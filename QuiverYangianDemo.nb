Cell[CellGroupData[{

Cell["\<\
Evaluate the partition function of framed NCDT invariants using Quiver \
Yangian algorithm\
\>", "Subtitle",
 CellChangeTimes->{{3.8182177011018887`*^9, 3.818217747184787*^9}, {
   3.818217829950395*^9, 3.8182178301395693`*^9}, {3.818217879807591*^9, 
   3.818217880776609*^9}, 3.885029877973387*^9, 3.9846534835974445`*^9, {
   3.9847970544882526`*^9, 
   3.9847970575371895`*^9}},ExpressionUUID->"bd6056ff-2589-482c-aa41-\
889b85020af2"],

Cell["\<\
We can compute unrefined and refined D6 framed NCDT invariants. The unrefined \
series are given as a polynomial in term of y, where y should be replaced by \
1 to get the unrefined invariant and replaced by -1 to get the raw counting \
of molten crystals. It is important to highlight that this y is not a \
refinement, only a variable interpolating between the unrefined serie and the \
molten crystal count.\
\>", "Text",
 CellChangeTimes->{{3.984798197890671*^9, 3.9847982204503593`*^9}, {
  3.9848247184253407`*^9, 
  3.9848248455326176`*^9}},ExpressionUUID->"150e48c5-efe2-b047-ae32-\
a1bc4c9fa971"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Nn", "=", "7"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"substitute", " ", "y"}], "=", 
     RowBox[{"1", " ", "to", " ", "get", " ", "unrefined"}]}], ",", " ", 
    RowBox[{"y", "=", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "to", " ", "get", " ", "raw", " ", 
      "counting"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Z1", "=", 
  RowBox[{"UnrefinedSeriesFromCrystal", "[", 
   RowBox[{"hMat", ",", 
    RowBox[{"D6Framing", "[", 
     RowBox[{"hMat", ",", "1"}], "]"}], ",", "Nn"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.816875714866087*^9, 3.8168757560359488`*^9}, {
   3.818217736040491*^9, 3.818217736710732*^9}, {3.8182178200548363`*^9, 
   3.8182178215433283`*^9}, 3.818217894419463*^9, {3.885029656222357*^9, 
   3.885029658313107*^9}, {3.885029777226241*^9, 3.8850297946372147`*^9}, {
   3.8850298468739758`*^9, 3.885029864589884*^9}, {3.984798138103218*^9, 
   3.984798142665516*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"41efe341-b81b-4eb2-97bb-61aed77f1a27"],

