Cell["\<\
Construct perfect matchings, and look for pairs of disjoint cuts\
\>", "Subtitle",
 CellChangeTimes->{{3.818217943701186*^9, 
  3.818217961532509*^9}},ExpressionUUID->"1caac919-4c4e-45ff-ad2c-\
bf6075890cd5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Perf", "=", 
   RowBox[{"ListPerfectMatchings", "[", 
    RowBox[{"Wp", ",", "Wm"}], "]"}]}], ";", 
  RowBox[{"LiDoubleCuts", "=", 
   RowBox[{"Drop", "[", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Intersection", "[", 
              RowBox[{
               RowBox[{"Perf", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"Perf", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "\[Equal]", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}], ",", 
            RowBox[{"{", "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "Perf", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"i", "+", "1"}], ",", 
            RowBox[{"Length", "[", "Perf", "]"}]}], "}"}]}], "]"}], ",", 
        "1"}], "]"}], "]"}], ",", "1"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8172940159642763`*^9, 3.8172941249480762`*^9}, {
   3.8172947412917852`*^9, 3.8172947442016897`*^9}, 3.817295049044827*^9, {
